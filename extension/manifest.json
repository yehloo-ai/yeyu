{
  "manifest_version": 3,
  "name": "页屿 Yeyu · 网页工作台",
  "version": "1.0.1",
  "description": "以网页截图识别常用入口，支持拖拽排序、RSS 更新数字和网页变化提示。数据保存在本机。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "alarms", "offscreen", "activeTab"],
  "optional_permissions": ["bookmarks"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; img-src 'self' data:; frame-src 'none'"
  },
  "action": {
    "default_title": "保存当前网页缩略图到快捷入口",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
